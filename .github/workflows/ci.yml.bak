name: CI

on:
  push:
    branches: [main, master]
  pull_request:

jobs:
  test:
    name: test (${{ matrix.os }}, node ${{ matrix.node }})
    strategy:
      fail-fast: false
      matrix:
        os: [windows-latest, ubuntu-latest, macos-latest]
        node: [22, 24]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ matrix.node }}
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Verify WASM grammar matrix
        # На Windows/Node 24 без --liftoff-only загрузка 30+ грамматик
        # нестабильна (см. план_wasm.md §1.3) — флаг обязателен.
        run: node --liftoff-only scripts/verify-wasm.mjs

      - name: Run tests (pretest собирает бандл воркера)
        run: npm test

      - name: Compile (tsc + esbuild extension + worker + wasm assets)
        run: npm run compile

      - name: Check wasm assets in out/
        shell: pwsh
        run: |
          if (-not (Test-Path out/extension.js)) { throw "out/extension.js missing" }
          if (-not (Test-Path out/ParserWorker.js)) { throw "out/ParserWorker.js missing" }
          if (-not (Test-Path out/tree-sitter.wasm)) { throw "out/tree-sitter.wasm missing" }
          $n = (Get-ChildItem out/wasm -Filter *.wasm).Count
          if ($n -ne 31) { throw "expected 31 grammars in out/wasm, got $n" }
