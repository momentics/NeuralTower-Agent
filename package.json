{
  "name": "NeuralTower-Agent",
  "displayName": "NeuralTower Agent",
  "description": "Интеллектуальный ассистент для разработки на базе локальной модели Neural Tower",
  "version": "0.1.3",
  "repository": "https://github.com/NeuralTower-Agent/NeuralTower-Agent",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Chat"
  ],
  "activationEvents": [
    "onView:neuralTowerAgent.chat"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neuralTowerAgent",
          "title": "NeuralTower Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "neuralTowerAgent": [
        {
          "type": "webview",
          "id": "neuralTowerAgent.chat",
          "name": "Чат"
        }
      ]
    },
    "commands": [
      {
        "command": "neuralTowerAgent.newChat",
        "title": "Новый чат",
        "icon": "$(add)"
      },
      {
        "command": "neuralTowerAgent.settings",
        "title": "Открыть настройки",
        "icon": "$(settings-gear)"
      },
      {
        "command": "neuralTowerAgent.focusChatInput",
        "title": "Перейти к полю ввода чата"
      },
      {
        "command": "neuralTowerAgent.explainCode",
        "title": "Объяснить код",
        "icon": "$(comment)"
      },
      {
        "command": "neuralTowerAgent.fixCode",
        "title": "Исправить код",
        "icon": "$(wrench)"
      },
      {
        "command": "neuralTowerAgent.improveCode",
        "title": "Улучшить код",
        "icon": "$(lightbulb)"
      },
      {
        "command": "neuralTowerAgent.addToContext",
        "title": "Добавить в контекст",
        "icon": "$(plug)"
      },
      {
        "command": "neuralTowerAgent.generateCommitMessage",
        "title": "Сгенерировать текст коммита",
        "icon": "$(git-commit)"
      },
      {
        "command": "neuralTowerAgent.session.list",
        "title": "Список сессий"
      },
      {
        "command": "neuralTowerAgent.openDiffViewer",
        "title": "Показать изменения",
        "icon": "$(diff)"
      },
      {
        "command": "neuralTowerAgent.reindex",
        "title": "Повторная индексация кодовой базы",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "neuralTowerAgent.newChat",
          "when": "view == neuralTowerAgent.chat",
          "group": "navigation"
        },
        {
          "command": "neuralTowerAgent.settings",
          "when": "view == neuralTowerAgent.chat",
          "group": "navigation"
        },
        {
          "command": "neuralTowerAgent.openDiffViewer",
          "when": "view == neuralTowerAgent.chat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "neuralTowerAgent.explainCode",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "neuralTowerAgent.fixCode",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "neuralTowerAgent.improveCode",
          "group": "9_cutcopypaste@3"
        },
        {
          "command": "neuralTowerAgent.addToContext",
          "group": "9_cutcopypaste@4"
        }
      ],
      "scm/title": [
        {
          "command": "neuralTowerAgent.generateCommitMessage",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "neuralTowerAgent.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus"
      },
      {
        "command": "neuralTowerAgent.explainCode",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus"
      },
      {
        "command": "neuralTowerAgent.fixCode",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorTextFocus"
      },
      {
        "command": "neuralTowerAgent.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus"
      },
      {
        "command": "neuralTowerAgent.newChat",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      }
    ],
    "configuration": {
      "title": "NeuralTower Agent",
      "properties": {
        "neuralTowerAgent.neuralTowerUrl": {
          "type": "string",
          "default": "http://localhost:30000",
          "description": "Адрес сервера Neural Tower SGLang"
        },
        "neuralTowerAgent.model": {
          "type": "string",
          "default": "qwen3.6-27b",
          "description": "Имя модели по умолчанию"
        },
        "neuralTowerAgent.maxRetries": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "Максимальное число повторных попыток при запросах к бэкенду"
        },
        "neuralTowerAgent.timeoutMs": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "Таймаут запроса в миллисекундах"
        },
        "neuralTowerAgent.maxSessions": {
          "type": "number",
          "default": 50,
          "minimum": 5,
          "maximum": 200,
          "description": "Максимальное число сохраняемых сессий"
        },
        "neuralTowerAgent.autoApprove.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Автоматически одобрять все небезопасные вызовы инструментов без запроса"
        },
        "neuralTowerAgent.autoApprove.tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Список имён инструментов для автоодобрения даже при отключённой общей функции"
        },
        "neuralTowerAgent.notifications.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить уведомления VS Code"
        },
        "neuralTowerAgent.notifications.agentCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Показывать уведомление при завершении задачи агентом"
        },
        "neuralTowerAgent.notifications.permissionRequests": {
          "type": "boolean",
          "default": true,
          "description": "Показывать уведомление для запросов разрешений"
        },
        "neuralTowerAgent.agent.maxIterations": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "description": "Максимальное число итераций вызова инструментов за один ход агента"
        },
        "neuralTowerAgent.git.injectDiffContext": {
          "type": "boolean",
          "default": true,
          "description": "Добавлять контекст git-различий в системный запрос агента"
        },
        "neuralTowerAgent.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Включить автодополнение кода (Inline Completion)"
        },
        "neuralTowerAgent.autocomplete.debounceMs": {
          "type": "number",
          "default": 150,
          "minimum": 10,
          "description": "Интервал дебаунса автодополнения в миллисекундах"
        },
        "neuralTowerAgent.autocomplete.maxPromptTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 128,
          "description": "Максимальное число токенов в промпте автодополнения"
        }
      }
    }
  },
  "versionScript": "node ./bump-version.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc --noEmit && esbuild ./src/Extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "glob": "^10.3.0",
    "web-tree-sitter": "^0.24.5"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.1",
    "ovsx": "^1.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  }
}
